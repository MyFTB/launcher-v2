{
  "name": "myftb-launcher",
  "version": "2.3.0-experimental.1",
  "description": "MyFTB Minecraft Modpack Launcher",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24.18.1 <25",
    "npm": ">=11.16.0 <13"
  },
  "scripts": {
    "predev": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "prepreview": "install-electron",
    "preview": "electron-vite preview",
    "postinstall": "node scripts/repair-xmcl.cjs",
    "prepare:electron": "install-electron",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "type-check": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p src/renderer/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "audit:full": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@xhayper/discord-rpc": "^1.3.4",
    "@xmcl/core": "^2.16.0",
    "@xmcl/installer": "^6.3.1",
    "electron-updater": "^6.8.9",
    "undici": "^8.10.0",
    "undici-xmcl": "npm:undici@^7.29.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  },
  "build": {
    "appId": "de.myftb.launcher",
    "productName": "MyFTB Launcher",
    "copyright": "Copyright © MyFTB",
    "icon": "resources/icon",
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "protocols": [
      {
        "name": "MyFTB Launcher",
        "schemes": [
          "myftb"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.games",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "resources/icon.png",
      "category": "Game"
    },
    "publish": {
      "provider": "github",
      "owner": "MyFTB",
      "repo": "launcher-v2"
    }
  },
  "license": "GPL-3.0-or-later",
  "overrides": {
    "@xmcl/asm": "^1.0.1",
    "@xmcl/core": "$@xmcl/core",
    "@xmcl/file-transfer": "^2.1.2",
    "@xmcl/forge-site-parser": "^2.0.9",
    "@xmcl/unzip": "^2.2.0",
    "@xmcl/yauzl": "^2.10.0"
  },
  "author": {
    "name": "MyFTB",
    "email": "info@myftb.de",
    "url": "https://myftb.de"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
